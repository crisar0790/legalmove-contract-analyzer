# Credentials
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Copy the base URL from your Langfuse project configuration.
LANGFUSE_HOST=

# Baseline models required by the project plan
VISION_MODEL=gpt-4o
AGENT_MODEL=gpt-6.1-sol

# Timeout per HTTP attempt, in seconds
REQUEST_TIMEOUT_SECONDS=60

# Additional retries: 0 means one attempt with no retries
MAX_RETRIES=2

# Initial output budgets; adjust after evaluation
VISION_MAX_OUTPUT_TOKENS=4096
CONTEXT_MAX_OUTPUT_TOKENS=2048
EXTRACTION_MAX_OUTPUT_TOKENS=2048

# Application input limit in bytes
MAX_IMAGE_SIZE_BYTES=10000000